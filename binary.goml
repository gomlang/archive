package archive;

use std::bytes;
use std::utf8;
use utf8::BytesUtf8;

// Four reflected IEEE polynomial steps for each possible low nibble.

const CRC32_NIBBLES: [u32; 16] = [
    0x00000000,
    0x1db71064,
    0x3b6e20c8,
    0x26d930ac,
    0x76dc4190,
    0x6b6b51f4,
    0x4db26158,
    0x5005713c,
    0xedb88320,
    0xf00f9344,
    0xd6d6a3e8,
    0xcb61b38c,
    0x9b64c2b0,
    0x86d3d2d4,
    0xa00ae278,
    0xbdbdf21c,
];

fn zeros(count: isize) -> bytes::Bytes {
    let result = bytes::Bytes::with_capacity(count);
    for _ in 0..count {
        result.push(0)
    }
    result
}

fn part(data: bytes::Bytes, start: isize, length: isize) -> Result[bytes::Bytes, Error] {
    if start < 0 || length < 0 || start > data.len() || length > data.len() - start {
        return Result::Err(failure(ErrorKind::Truncated, start, "truncated field"))
    }
    Result::Ok(bytes::Bytes::from_slice_copy(data.slice(start, start + length)))
}

fn text(data: bytes::Bytes) -> Result[string, Error] {
    data.to_string_utf8().map_err(|error| failure(ErrorKind::Invalid, 0, error.to_string()))
}

fn le(data: bytes::Bytes, offset: isize, size: isize) -> Result[u64, Error] {
    if offset < 0 || size < 0 || offset > data.len() || size > data.len() - offset {
        return Result::Err(failure(ErrorKind::Truncated, offset, "truncated field"))
    }
    let mut value: u64 = 0;
    for index in 0..size {
        value |= data.get(offset + index).to_u64() << (index * 8).to_u64();
    }
    Result::Ok(value)
}

fn put_le(data: bytes::Bytes, value: u64, size: isize) -> () {
    for index in 0..size {
        data.push((value >> (index * 8).to_u64()).to_u8())
    }
}

pub fn crc32(data: bytes::Bytes) -> u32 {
    crc32_update(0, data.as_slice())
}

pub fn crc32_update(previous: u32, data: Slice[byte]) -> u32 {
    let mut value = previous ^ 0xffffffff;
    for byte in data {
        value ^= byte.to_u32();
        value = (value >> 4) ^ CRC32_NIBBLES[(value & 15).to_isize()];
        value = (value >> 4) ^ CRC32_NIBBLES[(value & 15).to_isize()];
    }
    value ^ 0xffffffff
}

fn decimal(value: string) -> Result[u64, Error] {
    if value == "" {
        return Result::Err(failure(ErrorKind::Invalid, 0, "empty decimal"))
    }
    let mut result: u64 = 0;
    for digit in value.to_bytes() {
        if digit < b'0' || digit > b'9'
            || result > (18446744073709551615 - (digit - b'0').to_u64()) / 10 {
            return Result::Err(failure(ErrorKind::Invalid, 0, "invalid decimal"))
        }
        result = result * 10 + (digit - b'0').to_u64();
    }
    Result::Ok(result)
}
