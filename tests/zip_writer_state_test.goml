package tests;

use ecosystem::archive;
use archive::{Compression, Entry, ErrorKind, Header, Limits, ZipWriter};
use std::bytes;
use std::io;
use io::Write;
use std::testing;

fn zip_rejects_source_after_terminal_state[W: Write](writer: ZipWriter[W]) -> () {
    let source = io::Cursor::new(bytes::Bytes::from_string("payload"));
    let alias = writer;
    for size in Vec::from_array([7, -1, 0]) {
        let error = testing::expect_err(
            alias.append_reader(Header::file("late"), size, source, Compression::Stored),
            "terminal writer rejects input",
        );
        testing::assert_eq(error.kind, ErrorKind::Closed);
        testing::assert_eq(source.position(), 0);
    }
}

#[test]
fn zip_finished_writer_rejects_reader_without_consuming_input() -> () {
    let output = io::Cursor::new(bytes::Bytes::new());
    let writer = testing::expect_ok(ZipWriter::new(output, Limits::standard()), "ZIP writer");
    testing::expect_ok(writer.finish(""), "finish ZIP");
    let length = output.bytes().len();
    zip_rejects_source_after_terminal_state(writer);
    testing::assert_eq(output.bytes().len(), length);
}

#[test]
fn zip_failed_writer_rejects_reader_without_consuming_input() -> () {
    let calls = Ref::new(0);
    let output = io::Cursor::new(bytes::Bytes::new());
    let writer = testing::expect_ok(
        ZipWriter::new(ShortWriter { output, fail_at: 1, calls }, Limits::standard()),
        "ZIP writer",
    );
    testing::assert_err(writer.append(Entry::directory("directory/"), Compression::Stored));
    zip_rejects_source_after_terminal_state(writer);
    testing::assert_eq(calls.get(), 1);
    let flushes = Ref::new(0);
    let writer = testing::expect_ok(
        ZipWriter::new(FlushFailure { output, flushes }, Limits::standard()),
        "ZIP writer",
    );
    testing::assert_err(writer.finish(""));
    let length = output.bytes().len();
    zip_rejects_source_after_terminal_state(writer);
    testing::assert_eq(flushes.get(), 1);
    testing::assert_eq(output.bytes().len(), length);
}
